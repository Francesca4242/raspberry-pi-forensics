#!/usr/bin/env bash
# Simple text menu for the floppy forensics station.

CASES="$HOME/cases"
PATH="$PATH:/usr/games"
have() { command -v "$1" >/dev/null 2>&1; }
pause() { echo; read -r -p "Press Enter to return to the menu... " _; }

FORMATS=(
    ibm.1440        "PC 3.5\" HD 1.44MB"
    ibm.720         "PC 3.5\" DD 720KB"
    ibm.1200        "PC 5.25\" HD 1.2MB"
    ibm.360         "PC 5.25\" DD 360KB"
    amiga.amigados  "Amiga 880KB"
    atari.st.720    "Atari ST 720KB"
    mac.800         "Macintosh 800KB (GCR)"
    mac.400         "Macintosh 400KB (GCR)"
    commodore.1541  "Commodore 64 (needs 40-track 5.25\" drive)"
    flux            "Unknown: raw flux only"
)

capture() {
    local id fmt note
    id=$(whiptail --inputbox "Accession / case ID (letters, digits, . _ -):" 9 60 \
        "$(date +%Y%m%d)-001" 3>&1 1>&2 2>&3) || return
    fmt=$(whiptail --menu "Disk format" 20 70 10 "${FORMATS[@]}" 3>&1 1>&2 2>&3) || return
    note=$(whiptail --inputbox "Label text / notes (optional):" 9 70 3>&1 1>&2 2>&3) || return
    clear
    floppy-capture -f "$fmt" -n "$note" "$id"
    pause
}

games() {
    local items=() g
    local -A desc=(
        [nethack]="NetHack dungeon crawl" [crawl]="Dungeon Crawl Stone Soup"
        [angband]="Angband" [frotz]="Infocom-style text adventures"
        [adventure]="Colossal Cave Adventure" [tetris-bsd]="Tetris"
        [robots]="Robots" [worm]="Worm" [hangman]="Hangman"
        [ninvaders]="Space invaders" [moon-buggy]="Moon buggy"
        [greed]="Greed" [pacman4console]="Pac-Man-like" [nsnake]="Snake"
        [dosbox]="DOS emulator (run games off your disk images)"
        [fs-uae-launcher]="Amiga emulator" [hatari]="Atari ST emulator"
        [x64sc]="Commodore 64 emulator (VICE)"
    )
    for g in nethack crawl angband adventure tetris-bsd robots worm hangman \
             ninvaders moon-buggy greed pacman4console nsnake frotz \
             dosbox fs-uae-launcher hatari x64sc; do
        have "$g" && items+=("$g" "${desc[$g]}")
    done
    ((${#items[@]})) || { whiptail --msgbox "No games installed." 8 40; return; }
    g=$(whiptail --menu "Games" 22 70 14 "${items[@]}" 3>&1 1>&2 2>&3) || return
    clear
    if [[ $g == frotz ]]; then
        echo "Usage: frotz story.z5   (Infocom/Inform story files)"; pause; return
    fi
    "$g"
}

while true; do
    choice=$(whiptail --title "Floppy Forensics Station" --menu "" 20 64 11 \
        1 "Capture & analyse a floppy" \
        2 "Greaseweazle info" \
        3 "Measure drive RPM" \
        4 "Browse cases (Midnight Commander)" \
        5 "Identify formats in a folder (PRONOM)" \
        6 "Write-block status" \
        7 "Update siegfried signatures" \
        8 "Games" \
        9 "Shell" \
        0 "Quit" 3>&1 1>&2 2>&3) || exit 0
    case $choice in
        1) capture ;;
        2) clear; gw info; pause ;;
        3) clear; echo "Insert any disk; Ctrl-C to stop."; gw rpm; pause ;;
        4) mkdir -p "$CASES"; mc "$CASES" ;;
        5) dir=$(whiptail --inputbox "Folder:" 8 70 "$CASES" 3>&1 1>&2 2>&3) || continue
           clear
           if have sf; then sf "$dir" | less; else fido -recurse "$dir" | less; fi ;;
        6) clear; write-block status; pause ;;
        7) clear; sf -update; pause ;;
        8) games ;;
        9) clear; echo "Type 'exit' to return to the menu."; "${SHELL:-bash}" ;;
        0) exit 0 ;;
    esac
done
